<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/appBg"
    android:clickable="true"
    android:focusable="true">

    <!-- 顶部栏 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <TextView
            android:id="@+id/btnCollapse"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="⌄"
            android:textColor="@color/textSecondary"
            android:textSize="26sp"
            android:contentDescription="@string/player_close" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="260dp"
                android:textColor="@color/textPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="260dp"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- 封面 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <ImageView
            android:id="@+id/playerCover"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_cover"
            android:scaleType="centerCrop"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_cover_placeholder" />

    </FrameLayout>

    <!-- 歌词 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lrcList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="60dp"
            android:paddingBottom="60dp"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/lrcHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/textSecondary"
            android:textSize="14sp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- 进度条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/textCurTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="42dp"
            android:text="0:00"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:max="1000"
            android:progress="0"
            android:progressTint="@color/moonGold"
            android:progressBackgroundTint="@color/divider"
            android:thumbTint="@color/moonGold" />

        <TextView
            android:id="@+id/textDurTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="42dp"
            android:gravity="end"
            android:text="0:00"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- 控制按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <ImageButton
            android:id="@+id/btnPrev"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notif_action_prev"
            android:scaleType="fitCenter"
            android:padding="12dp"
            android:src="@drawable/ic_prev"
            app:tint="@color/textPrimary" />

        <FrameLayout
            android:id="@+id/btnPlayWrap"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_gold_circle">

            <ImageView
                android:id="@+id/btnPlayToggle"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="@string/notif_action_toggle_play"
                android:src="@drawable/ic_play"
                app:tint="#FFFFFF" />

        </FrameLayout>

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notif_action_next"
            android:scaleType="fitCenter"
            android:padding="12dp"
            android:src="@drawable/ic_next"
            app:tint="@color/textPrimary" />

    </LinearLayout>

</LinearLayout>
