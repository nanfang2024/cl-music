<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight：亮暗切换由 values / values-night 中的同名色值自动驱动 -->
    <style name="Theme.YingYue" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/moonGold</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/moonGold</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:colorBackground">@color/appBg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        <item name="colorSurfaceVariant">@color/surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/textSecondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:statusBarColor">@color/appBg</item>
        <item name="android:navigationBarColor">@color/appBg</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textColorHint">@color/textSecondary</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
