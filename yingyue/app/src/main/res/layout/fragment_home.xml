<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶部固定区域：标题/搜索/筛选 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- 标题：映月 + 副标题 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/app_name"
                android:textColor="@color/moonGold"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="@string/app_slogan"
                android:textColor="@color/textSecondary"
                android:textSize="15sp" />

            <!-- 搜索行：输入框 + 按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/inputKeyword"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_input"
                    android:drawablePadding="8dp"
                    android:drawableStart="@drawable/ic_search_gold"
                    android:hint="@string/hint_search_v121"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp"
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/textTertiary"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_btn_search"
                    android:minWidth="90dp"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="13dp"
                    android:text="@string/btn_search"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 音源行：标签 + chip（紫色选中，白色未选） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_source"
                    android:textColor="@color/textSecondary"
                    android:textSize="15sp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipNetease"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:checked="true"
                    android:checkable="true"
                    android:text="@string/source_netease"
                    android:textColor="@color/chip_text"
                    android:textSize="14sp"
                    app:chipBackgroundColor="@drawable/bg_chip"
                    app:chipMinHeight="36dp"
                    app:checkedIcon="@null"
                    app:chipIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipJoox"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:checkable="true"
                    android:text="@string/source_joox"
                    android:textColor="@color/chip_text"
                    android:textSize="14sp"
                    app:chipBackgroundColor="@drawable/bg_chip"
                    app:chipMinHeight="36dp"
                    app:checkedIcon="@null"
                    app:chipIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipKuwo"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:checkable="true"
                    android:text="@string/source_kuwo"
                    android:textColor="@color/chip_text"
                    android:textSize="14sp"
                    app:chipBackgroundColor="@drawable/bg_chip"
                    app:chipMinHeight="36dp"
                    app:checkedIcon="@null"
                    app:chipIconVisible="false" />
            </LinearLayout>

            <!-- 音质行：标签 + 水平滚动 chip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_quality"
                    android:textColor="@color/textSecondary"
                    android:textSize="15sp" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/qualityGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipQuality128"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:checkable="true"
                            android:text="128k"
                            android:textColor="@color/chip_text"
                            android:textSize="14sp"
                            app:chipBackgroundColor="@drawable/bg_chip"
                            app:chipMinHeight="36dp"
                            app:checkedIcon="@null"
                            app:chipIconVisible="false" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipQuality192"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="192k"
                            android:textColor="@color/chip_text"
                            android:textSize="14sp"
                            app:chipBackgroundColor="@drawable/bg_chip"
                            app:chipMinHeight="36dp"
                            app:checkedIcon="@null"
                            app:chipIconVisible="false" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipQuality320"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="320k"
                            android:textColor="@color/chip_text"
                            android:textSize="14sp"
                            app:chipBackgroundColor="@drawable/bg_chip"
                            app:chipMinHeight="36dp"
                            app:checkedIcon="@null"
                            app:chipIconVisible="false" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipQuality740"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="740k"
                            android:textColor="@color/chip_text"
                            android:textSize="14sp"
                            app:chipBackgroundColor="@drawable/bg_chip"
                            app:chipMinHeight="36dp"
                            app:checkedIcon="@null"
                            app:chipIconVisible="false" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipQuality999"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="999k"
                            android:textColor="@color/chip_text"
                            android:textSize="14sp"
                            app:chipBackgroundColor="@drawable/bg_chip"
                            app:chipMinHeight="36dp"
                            app:checkedIcon="@null"
                            app:chipIconVisible="false" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:background="@color/sectionDivider" />

            <!-- 搜索状态行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/progressSearch"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 播放状态栏 -->
            <TextView
                android:id="@+id/textPlayerBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_pill"
                android:padding="8dp"
                android:textColor="@color/moonGold"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- 结果列表（独立滚动，支持分页加载） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listTracks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp" />

</LinearLayout>
